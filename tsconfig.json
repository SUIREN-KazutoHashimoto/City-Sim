{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitOverride": true,
    "useDefineForClassFields": true, "skipLibCheck": true, "isolatedModules": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
